    <string name="message_help">Nếu bạn cần hỗ trợ, hãy liên hệ tổng đài Melobi.\n\nHotline: 1900 636 245\nEmail: hotro@melobi.edu.vn\nThời gian: 8:00 - 21:00 hàng ngày.</string>
